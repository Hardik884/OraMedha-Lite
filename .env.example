# =============================================================================
# OraMedha Lite — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is in .gitignore).
# =============================================================================

# Supabase — safe for the browser (NEXT_PUBLIC_ prefix).
# Hosted project: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only. Never prefix with NEXT_PUBLIC_.
# Not used by the app yet; reserved for admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI — read automatically by `npx supabase …` in this folder, so
# `npm run db:push` and `npm run gen:types` work without `supabase login`
# (and without touching the CLI login you use for other projects).
#   Access token: supabase.com/dashboard/account/tokens (account that owns the project)
#   DB password:  Project Settings → Database
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
