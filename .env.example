# =============================================================================
# OraMedha Lite — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (it is in .gitignore).
# =============================================================================

# Supabase — safe for the browser (NEXT_PUBLIC_ prefix).
# Local stack: run `npm run db:start`, then copy "API URL" and "anon key"
# from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only. Never prefix with NEXT_PUBLIC_.
# Not used by the app yet; reserved for admin scripts.
SUPABASE_SERVICE_ROLE_KEY=
